# EduGo Environment Variables Example

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
PUBLIC_URL=http://localhost:5000

# Database
MONGODB_URI=mongodb://localhost:27017/edugo

# JWT Authentication
JWT_SECRET=supersecret_jwt_key_edugo_change_this_in_production_1234567890
JWT_EXPIRES_IN=7d

# Google OAuth Credentials (Optional: required for Google Sign-In)
# Obtain from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email Provider Configuration (Optional: for password recovery)
# If unconfigured, EduGo logs password reset links directly to backend console
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=EduGo <no-reply@edugo.org>

# Cloudinary Cloud Storage (Optional: for media/thumbnail uploads)
# If unconfigured, EduGo securely stores uploaded assets locally in /uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
